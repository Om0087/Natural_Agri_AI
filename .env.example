# KrushiMitra AI - Environment Configuration Example
# Copy this file to .env and insert your actual Groq API key:

# Groq Cloud AI Configuration (Free ultra-fast LLM API)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"
USE_GROQ="true"

# Local LM Studio Configuration (Optional Offline Fallback)
LM_STUDIO_BASE_URL="http://localhost:1234/v1"
LM_STUDIO_API_KEY="lm-studio"
LLM_MODEL="qwen2.5-coder-1.5b-instruct"

# Flask Server Port (Default: 5000)
PORT=5000
